{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../../dist/game-server",
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": ["./*.ts", "../../src/game/shared/*.ts"],
  "exclude": ["../../src/game/shared/*.test.ts", "./*.test.ts"]
}
