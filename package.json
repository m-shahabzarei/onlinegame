{
  "name": "twoplayer",
  "version": "0.1.0",
  "private": true,
  "description": "Platform core and discovery experience for TwoPlayer cooperative gaming.",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "typegen": "next typegen",
    "game:build": "tsc -p services/game-server/tsconfig.json",
    "game:start": "node --env-file-if-exists=.env dist/game-server/services/game-server/main.js",
    "game:dev": "npm run game:build && npm run game:start",
    "test:game": "vitest run src/game services/game-server src/server/gameplay --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "playwright test",
    "game:profile": "npm run game:build && node scripts/profile-gameplay.mjs",
    "game:pve:profile": "npm run game:build && node --expose-gc scripts/profile-pve.mjs",
    "test:pve": "vitest run services/game-server/pve src/game/client/zombie-buffer.test.ts --maxWorkers=1 --no-file-parallelism",
    "release:check": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.4",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
