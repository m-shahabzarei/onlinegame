# Required for Prisma commands and database-aware server routes.
# Local placeholder only; replace it in .env so both Prisma CLI and Next.js can load it.
DATABASE_URL="postgresql://twoplayer:change-me@localhost:5432/twoplayer?schema=public"

# Authentication mode. `database` is the default PostgreSQL-backed implementation.
# Use `development` only for an explicitly isolated local preview/test adapter.
AUTH_MODE="database"
SESSION_COOKIE_NAME="twoplayer_session"
SESSION_TTL_DAYS="30"

# Public web configuration (safe to expose to the browser).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Enforce NEXT_PUBLIC_APP_URL for state-changing origins in non-production previews.
TWOPLAYER_ENFORCE_ORIGIN="0"

# Production uses ably with database auth. Local testing: AUTH_MODE=development,
# REALTIME_PROVIDER=local, and omit DATABASE_URL for the local catalog.
REALTIME_PROVIDER="ably"
REALTIME_SERVER_URL=""
REALTIME_SERVER_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional observability endpoints. No SDK integration is enabled in Phase 2.
OTEL_EXPORTER_OTLP_ENDPOINT=""
SENTRY_DSN=""

# Phase 4: website/client on Vercel, authoritative gameplay on an external service.
# Generate DIFFERENT random values of at least 32 characters; never NEXT_PUBLIC.
GAMEPLAY_JOIN_SECRET=""
GAMEPLAY_CONTROL_SECRET=""
# Web application only; the bootstrap response supplies the public socket URL.
GAMEPLAY_SERVER_HTTP_URL="http://127.0.0.1:8080"
GAMEPLAY_WS_URL="ws://localhost:8080/gameplay"
# Persistent gameplay service only. Production binds 0.0.0.0 behind TLS.
GAMEPLAY_HOST="127.0.0.1"
GAMEPLAY_PORT="8080"
GAMEPLAY_WEB_URL="http://localhost:3000"
GAMEPLAY_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
GAMEPLAY_TICK_RATE="30"
GAMEPLAY_SNAPSHOT_RATE="15"
GAMEPLAY_STARTUP_MS="90000"
GAMEPLAY_RECONNECT_MS="30000"
# Vercel cron authenticates the lease sweeper with this secret.
CRON_SECRET=""
# Optional protected operator status token; never expose it to NEXT_PUBLIC variables.
OPS_HEALTH_TOKEN=""

# Phase 8 safe operation flags. Keep risky switches false unless explicitly enabled.
TWOPLAYER_FLAG_ONBOARDING="1"
TWOPLAYER_FLAG_CHALLENGES="1"
TWOPLAYER_FLAG_COSMETICS="1"
TWOPLAYER_FLAG_PUBLIC_ROOMS="1"
TWOPLAYER_FLAG_ANALYTICS="0"
TWOPLAYER_FLAG_MAINTENANCE="0"
TWOPLAYER_FLAG_GAME_AVAILABLE="1"
TWOPLAYER_TELEMETRY_SAMPLE_RATE="0.1"
